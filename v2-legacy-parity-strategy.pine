//@version=6
// =============================================================================
// V2 LEGACY PARITY + EXPERIMENTAL STRATEGY  (one consolidated build)
// MODE A - LEGACY SIGNAL BENCHMARK: exact TSI + exact divergence + candle #1-3
//          + completed 4H timing. NO trendline. NOT Terry's strategy result -
//          a benchmark of the reliably reproducible elements only.
// MODE B - EXPERIMENTAL AUTO-TRENDLINE: adds the counter-move trendline
//          approximation. EXPERIMENTAL - TRENDLINE PARITY NOT APPROVED.
// Pine CANNOT read manually drawn trendline objects - acknowledged limitation;
// that is why Mode A exists.
// MARKERS: GREEN CIRCLE = Everget bullish TSI crossover. RED CIRCLE = bearish.
// TEAL/ORANGE label = divergence count (toggle). GREY DIAMOND = mechanical
// trendline break (Mode B). BLUE UP TRIANGLE = LONG entry. ORANGE DOWN
// TRIANGLE = SHORT entry. ONLY the triangles are trades.
// PROVISIONAL items (labelled): divergence context lifecycle (pivot
// invalidation); Mode-B TSI->break gap allowance (default 2, unmeasured).
// Frozen rules: 4H only; entry at completed signal/break candle close;
// candle #1-3 (doji preserves run); stop = anchor wick -/+ 0.1*ATR(14);
// risk = 2% of current equity; target exactly 1R; no extra filters.
// Tester results are GROSS; cost-adjusted layer shown separately in dashboard.
// =============================================================================
strategy(title="V2 Legacy Parity + Experimental", shorttitle="V2 LP+EXP",
     overlay=true, initial_capital=10000, pyramiding=0,
     process_orders_on_close=true, calc_on_every_tick=false,
     max_bars_back=1000, max_labels_count=500, max_lines_count=500,
     margin_long=0, margin_short=0)

grpM = "Mode"
testMode = input.string(defval="A - Legacy Signal Benchmark", title="Test Mode", options=["A - Legacy Signal Benchmark", "B - Experimental Auto-Trendline"], group=grpM)

grpS = "Risk (frozen rules)"
riskPct = input.float(defval=2.0, title="Risk per trade (pct of current equity)", minval=0.1, maxval=10, step=0.1, group=grpS)
atrLen = input.int(defval=14, title="ATR length (stop buffer)", minval=1, group=grpS)
bufMult = input.float(defval=0.1, title="Stop buffer (x ATR)", minval=0.0, step=0.05, group=grpS)
maxSeq = input.int(defval=3, title="Max directional candle # at entry", minval=1, maxval=10, group=grpS)
tsiGapMax = input.int(defval=2, title="PROVISIONAL (Mode B): max bars TSI cross -> break", minval=0, maxval=10, group=grpS)
allowLong = input.bool(defval=true, title="Allow longs", group=grpS)
allowShort = input.bool(defval=true, title="Allow shorts", group=grpS)

grpC = "Costs (explicit - dashboard layer only)"
spreadPips = input.float(defval=0.8, title="Assumed spread (pips)", minval=0.0, step=0.1, group=grpC)
slipPips = input.float(defval=0.2, title="Assumed slippage (pips)", minval=0.0, step=0.1, group=grpC)

grpTL = "Mode B trendline (EXPERIMENTAL)"
tolMult = input.float(defval=0.075, title="Touch tolerance (x ATR14)", minval=0.01, maxval=0.5, step=0.005, group=grpTL)
implCap = input.int(defval=100, title="Max structure age, bars (IMPLEMENTATION LIMIT)", minval=20, maxval=300, group=grpTL)
showLine = input.bool(defval=true, title="Show active trendline (Mode B)", group=grpTL)

grpV = "Display"
showTsiCircles = input.bool(defval=true, title="TSI crossover circles", group=grpV)
showDivLabels = input.bool(defval=false, title="Divergence count labels", group=grpV)
showBrkDiamonds = input.bool(defval=true, title="Trendline-break diamonds (Mode B)", group=grpV)
showTradeDetail = input.bool(defval=false, title="Per-trade risk diagnostics label + stop anchor", group=grpV)
showDash = input.bool(defval=true, title="Performance dashboard", group=grpV)
showParity = input.bool(defval=false, title="T1-T8 / S1-S2 parity audit table (AUDUSD examples)", group=grpV)

grpT = "TSI (archived Everget logic)"
tsiLongLen = input.int(defval=6, title="TSI Long Length", minval=1, group=grpT)
tsiShortLen = input.int(defval=12, title="TSI Short Length", minval=1, group=grpT)
tsiSigLen = input.int(defval=2, title="TSI Signal Length", minval=1, group=grpT)

grpD = "Divergence engine (archived LTB v4 source, Terry's settings)"
prd = input.int(defval=5, title="Pivot Period", minval=1, maxval=50, group=grpD)
usePivotClose = input.bool(defval=true, title="Pivots use Close (off = High/Low)", group=grpD)
divTypeReg = input.bool(defval=true, title="Detect Regular divergence", group=grpD)
divTypeHid = input.bool(defval=true, title="Detect Hidden divergence", group=grpD)
showlimit = input.int(defval=1, title="Minimum Number of Divergence", minval=1, maxval=11, group=grpD)
maxpp = input.int(defval=10, title="Maximum Pivot Points to Check", minval=1, maxval=20, group=grpD)
maxbars = input.int(defval=100, title="Maximum Bars to Check", minval=30, maxval=200, group=grpD)
dontconfirm = input.bool(defval=true, title="Dont Wait for Confirmation (evaluated at close)", group=grpD)

isModeA = str.startswith(testMode, "A")
validTF = timeframe.period == "240"

// ---------------- DIVERGENCE ENGINE (ported from Terry's v4 source) ----------
rsi14 = ta.rsi(close, 14)
[macdLine, macdSigL, macdHist] = ta.macd(close, 12, 26, 9)
moment = ta.mom(close, 10)
cci10 = ta.cci(close, 10)
obvS = ta.obv
stk = ta.sma(ta.stoch(close, high, low, 14), 3)
cmfRaw = ((close - low) - (high - close)) / (high - low) * volume
cmf = ta.sma(cmfRaw, 21) / ta.sma(volume, 21)
vwmacd = ta.vwma(close, 12) - ta.vwma(close, 26)
mfi14 = ta.mfi(close, 14)

pivotSeriesH = usePivotClose ? close : high
pivotSeriesL = usePivotClose ? close : low
float ph = ta.pivothigh(pivotSeriesH, prd, prd)
float pl = ta.pivotlow(pivotSeriesL, prd, prd)

var int maxarraysize = 20
var ph_positions = array.new_int(maxarraysize, 0)
var pl_positions = array.new_int(maxarraysize, 0)
var ph_vals = array.new_float(maxarraysize, 0.)
var pl_vals = array.new_float(maxarraysize, 0.)
var float lastPLwick = na
var float lastPHwick = na

if not na(ph)
    array.unshift(ph_positions, bar_index)
    array.unshift(ph_vals, ph)
    if array.size(ph_positions) > maxarraysize
        array.pop(ph_positions)
        array.pop(ph_vals)
    lastPHwick := high[prd]
if not na(pl)
    array.unshift(pl_positions, bar_index)
    array.unshift(pl_vals, pl)
    if array.size(pl_positions) > maxarraysize
        array.pop(pl_positions)
        array.pop(pl_vals)
    lastPLwick := low[prd]

posDiv(srcSeries, cond) =>
    divlen = 0
    prsc = usePivotClose ? close : low
    if dontconfirm or srcSeries > srcSeries[1] or close > close[1]
        startpoint = dontconfirm ? 0 : 1
        for x = 0 to maxpp - 1
            len = bar_index - array.get(pl_positions, x) + prd
            if array.get(pl_positions, x) == 0 or len > maxbars
                break
            if len > 5 and ((cond == 1 and srcSeries[startpoint] > srcSeries[len] and prsc[startpoint] < nz(array.get(pl_vals, x))) or (cond == 2 and srcSeries[startpoint] < srcSeries[len] and prsc[startpoint] > nz(array.get(pl_vals, x))))
                slope1 = (srcSeries[startpoint] - srcSeries[len]) / (len - startpoint)
                virtual_line1 = srcSeries[startpoint] - slope1
                slope2 = (close[startpoint] - close[len]) / (len - startpoint)
                virtual_line2 = close[startpoint] - slope2
                arrived = true
                for y = 1 + startpoint to len - 1
                    if srcSeries[y] < virtual_line1 or nz(close[y]) < virtual_line2
                        arrived := false
                        break
                    virtual_line1 := virtual_line1 - slope1
                    virtual_line2 := virtual_line2 - slope2
                if arrived
                    divlen := len
                    break
    divlen

negDiv(srcSeries, cond) =>
    divlen = 0
    prsc = usePivotClose ? close : high
    if dontconfirm or srcSeries < srcSeries[1] or close < close[1]
        startpoint = dontconfirm ? 0 : 1
        for x = 0 to maxpp - 1
            len = bar_index - array.get(ph_positions, x) + prd
            if array.get(ph_positions, x) == 0 or len > maxbars
                break
            if len > 5 and ((cond == 1 and srcSeries[startpoint] < srcSeries[len] and prsc[startpoint] > nz(array.get(ph_vals, x))) or (cond == 2 and srcSeries[startpoint] > srcSeries[len] and prsc[startpoint] < nz(array.get(ph_vals, x))))
                slope1 = (srcSeries[startpoint] - srcSeries[len]) / (len - startpoint)
                virtual_line1 = srcSeries[startpoint] - slope1
                slope2 = (close[startpoint] - nz(close[len])) / (len - startpoint)
                virtual_line2 = close[startpoint] - slope2
                arrived = true
                for y = 1 + startpoint to len - 1
                    if srcSeries[y] > virtual_line1 or nz(close[y]) > virtual_line2
                        arrived := false
                        break
                    virtual_line1 := virtual_line1 - slope1
                    virtual_line2 := virtual_line2 - slope2
                if arrived
                    divlen := len
                    break
    divlen

calcDivs(enabled, indi) =>
    divs = array.new_int(4, 0)
    array.set(divs, 0, enabled and divTypeReg ? posDiv(indi, 1) : 0)
    array.set(divs, 1, enabled and divTypeReg ? negDiv(indi, 1) : 0)
    array.set(divs, 2, enabled and divTypeHid ? posDiv(indi, 2) : 0)
    array.set(divs, 3, enabled and divTypeHid ? negDiv(indi, 2) : 0)
    divs

allDivs = array.new_int(44, 0)
setDivs(divPtr, idx) =>
    for x = 0 to 3
        array.set(allDivs, idx * 4 + x, array.get(divPtr, x))

setDivs(calcDivs(true, macdLine), 0)
setDivs(calcDivs(true, macdHist), 1)
setDivs(calcDivs(true, rsi14), 2)
setDivs(calcDivs(true, stk), 3)
setDivs(calcDivs(true, cci10), 4)
setDivs(calcDivs(true, moment), 5)
setDivs(calcDivs(true, obvS), 6)
setDivs(calcDivs(true, vwmacd), 7)
setDivs(calcDivs(true, cmf), 8)
setDivs(calcDivs(true, mfi14), 9)

totalDiv = 0
for i = 0 to 43
    totalDiv += array.get(allDivs, i) > 0 ? 1 : 0
gateOpen = totalDiv >= showlimit

bullCnt = 0
bearCnt = 0
bullReg = 0
bullHid = 0
bearReg = 0
bearHid = 0
if gateOpen
    for x = 0 to 10
        for y = 0 to 3
            if array.get(allDivs, x * 4 + y) > 0
                if y % 2 == 0
                    bullCnt += 1
                    bullReg += y == 0 ? 1 : 0
                    bullHid += y == 2 ? 1 : 0
                else
                    bearCnt += 1
                    bearReg += y == 1 ? 1 : 0
                    bearHid += y == 3 ? 1 : 0
bullDiv = bullCnt > 0
bearDiv = bearCnt > 0

if showDivLabels and bullDiv and barstate.isconfirmed
    label.new(bar_index, math.min(low, low[1]), str.tostring(bullCnt) + "(" + str.tostring(bullReg) + "R/" + str.tostring(bullHid) + "H)", style=label.style_label_up, color=color.teal, textcolor=color.black, size=size.small)
if showDivLabels and bearDiv and barstate.isconfirmed
    label.new(bar_index, math.max(high, high[1]), str.tostring(bearCnt) + "(" + str.tostring(bearReg) + "R/" + str.tostring(bearHid) + "H)", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

// ---- PROVISIONAL divergence context lifecycle (pivot invalidation) ----------
var bool ctxBull = false
var float bullAnchor = na
var int bullDivBar = na
var bool ctxBear = false
var float bearAnchor = na
var int bearDivBar = na
if bullDiv
    ctxBull := true
    bullAnchor := nz(lastPLwick, low)
    bullDivBar := bar_index
if bearDiv
    ctxBear := true
    bearAnchor := nz(lastPHwick, high)
    bearDivBar := bar_index
if ctxBull and close < bullAnchor
    ctxBull := false
if ctxBear and close > bearAnchor
    ctxBear := false

// ----------------- TSI (archived Everget logic, line-for-line) ---------------
mo = ta.change(close)
tsiVal = 100 * ta.ema(ta.ema(mo, tsiLongLen), tsiShortLen) / ta.ema(ta.ema(math.abs(mo), tsiLongLen), tsiShortLen)
tsiSignal = ta.ema(tsiVal, tsiSigLen)
tsiCrossUp = ta.crossover(tsiVal, tsiSignal)
tsiCrossDn = ta.crossunder(tsiVal, tsiSignal)
gapUp = ta.barssince(tsiCrossUp)
gapDn = ta.barssince(tsiCrossDn)

plotshape(showTsiCircles and tsiCrossUp, title="TSI bullish crossover", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showTsiCircles and tsiCrossDn, title="TSI bearish crossover", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

var int runDir = 0
var int runLen = 0
if close > open
    if runDir == 1
        runLen += 1
    else
        runDir := 1
        runLen := 1
else if close < open
    if runDir == -1
        runLen += 1
    else
        runDir := -1
        runLen := 1

atrV = ta.atr(atrLen)
tol = tolMult * atrV

// ------------- MODE B: counter-move machines + frozen fit --------------------
var float loArmVal = na
var int loArmBar = na
var bool loActive = false
var float loOriginVal = na
var int loOriginBar = na
var float loDipVal = na
var int loDipBar = na
var float loLHVal = na
var int loLHBar = na

if not loActive
    if na(loArmVal) or high >= loArmVal
        loArmVal := high
        loArmBar := bar_index
    else
        loActive := true
        loOriginVal := loArmVal
        loOriginBar := loArmBar
        loDipVal := low
        loDipBar := bar_index
        loLHVal := na
        loLHBar := na
else
    if high > loOriginVal
        loActive := false
        loArmVal := high
        loArmBar := bar_index
    else
        if bar_index >= 2 and high[1] > high[2] and high[1] >= high and bar_index - 1 > loDipBar
            loLHVal := high[1]
            loLHBar := bar_index - 1
        if low < loDipVal
            if not na(loLHBar) and loLHBar > loDipBar
                loOriginVal := loLHVal
                loOriginBar := loLHBar
                loLHVal := na
                loLHBar := na
            loDipVal := low
            loDipBar := bar_index

var float shArmVal = na
var int shArmBar = na
var bool shActive = false
var float shOriginVal = na
var int shOriginBar = na
var float shPeakVal = na
var int shPeakBar = na
var float shHLVal = na
var int shHLBar = na

if not shActive
    if na(shArmVal) or low <= shArmVal
        shArmVal := low
        shArmBar := bar_index
    else
        shActive := true
        shOriginVal := shArmVal
        shOriginBar := shArmBar
        shPeakVal := high
        shPeakBar := bar_index
        shHLVal := na
        shHLBar := na
else
    if low < shOriginVal
        shActive := false
        shArmVal := low
        shArmBar := bar_index
    else
        if bar_index >= 2 and low[1] < low[2] and low[1] <= low and bar_index - 1 > shPeakBar
            shHLVal := low[1]
            shHLBar := bar_index - 1
        if high > shPeakVal
            if not na(shHLBar) and shHLBar > shPeakBar
                shOriginVal := shHLVal
                shOriginBar := shHLBar
                shHLVal := na
                shHLBar := na
            shPeakVal := high
            shPeakBar := bar_index

fitFrozen(isLong, oOff, oPrice, pOff) =>
    pFit = math.max(pOff, 1)
    float bestS = na
    int bestEv = -1
    int bestRaw = -1
    float bestD = 1e10
    if oOff - 1 >= pFit
        for a = pFit to oOff - 1
            for c = 0 to 1
                float pa = na
                if c == 0
                    pa := isLong ? high[a] : low[a]
                else
                    pa := isLong ? math.max(open[a], close[a]) : math.min(open[a], close[a])
                s = (pa - oPrice) / (oOff - a)
                if (isLong and s < 0) or (not isLong and s > 0)
                    valid = true
                    ev = 0
                    raw = 0
                    dSum = 0.0
                    lastK = -99
                    for k = oOff - 1 to pFit
                        lv = oPrice + s * (oOff - k)
                        if (isLong and close[k] > lv) or (not isLong and close[k] < lv)
                            valid := false
                            break
                        e1 = math.abs((isLong ? high[k] : low[k]) - lv)
                        e2 = math.abs((isLong ? math.max(open[k], close[k]) : math.min(open[k], close[k])) - lv)
                        e = math.min(e1, e2)
                        if e <= tol
                            raw += 1
                            dSum += e
                            if lastK == -99 or lastK - k >= 2
                                ev += 1
                            lastK := k
                    if valid
                        better = ev > bestEv or (ev == bestEv and raw > bestRaw) or (ev == bestEv and raw == bestRaw and dSum < bestD)
                        if better
                            bestS := s
                            bestEv := ev
                            bestRaw := raw
                            bestD := dSum
    consumed = false
    if not na(bestS) and pOff >= 2
        for k = pOff - 1 to 1
            lv = oPrice + bestS * (oOff - k)
            if (isLong and close[k] > lv) or (not isLong and close[k] < lv)
                consumed := true
                break
    float valNow = not na(bestS) ? oPrice + bestS * oOff : na
    float valPrev = not na(bestS) ? oPrice + bestS * (oOff - 1) : na
    [bestS, valNow, valPrev, consumed]

oOffL = loActive ? bar_index - loOriginBar : na
pOffL = loActive ? bar_index - loDipBar : na
fitOkL = loActive and not na(oOffL) and oOffL >= 3 and oOffL <= implCap
float slopeL = na
float lineL = na
float lineLprev = na
bool consL = false
if fitOkL
    [a1, a2, a3, a4] = fitFrozen(true, oOffL, loOriginVal, pOffL)
    slopeL := a1
    lineL := a2
    lineLprev := a3
    consL := a4

oOffS = shActive ? bar_index - shOriginBar : na
pOffS = shActive ? bar_index - shPeakBar : na
fitOkS = shActive and not na(oOffS) and oOffS >= 3 and oOffS <= implCap
float slopeS = na
float lineS = na
float lineSprev = na
bool consS = false
if fitOkS
    [b1, b2, b3, b4] = fitFrozen(false, oOffS, shOriginVal, pOffS)
    slopeS := b1
    lineS := b2
    lineSprev := b3
    consS := b4

breakLong = fitOkL and not na(lineL) and not consL and close > lineL and close[1] <= lineLprev
breakShort = fitOkS and not na(lineS) and not consS and close < lineS and close[1] >= lineSprev

// Approved reset: one break -> structure consumed -> immediate re-arm
if breakLong and barstate.isconfirmed
    loActive := false
    loArmVal := high
    loArmBar := bar_index
if breakShort and barstate.isconfirmed
    shActive := false
    shArmVal := low
    shArmBar := bar_index

plotshape(showBrkDiamonds and not isModeA and breakLong, title="TL break long-side", style=shape.diamond, location=location.belowbar, color=color.new(color.gray, 20), size=size.tiny)
plotshape(showBrkDiamonds and not isModeA and breakShort, title="TL break short-side", style=shape.diamond, location=location.abovebar, color=color.new(color.gray, 20), size=size.tiny)

// --------------------- ENTRY LOGIC + REJECTION AUDIT -------------------------
seqOkL = runDir == 1 and runLen <= maxSeq
seqOkS = runDir == -1 and runLen <= maxSeq
flat = strategy.position_size == 0
pip = syminfo.mintick * 10

var int rNoDiv = 0
var int rGap = 0
var int rSeq = 0
var int rStop = 0
var int rBlocked = 0
var int rNoBrk = 0
var int entriesL = 0
var int entriesS = 0
var int g0 = 0
var int g1 = 0
var int g2 = 0
var int g3p = 0
var float eStop = na
var float eTgt = na
var float lastRiskAcct = na
var float lastDist = na
var float sumCostR = 0.0
var bool crossServedL = true
var bool crossServedS = true

// long candidate signal per mode
longSig = isModeA ? tsiCrossUp : breakLong
shortSig = isModeA ? tsiCrossDn : breakShort
longEntry = false
shortEntry = false

if not isModeA and tsiCrossUp
    if not crossServedL
        rNoBrk += 1
    crossServedL := false
if not isModeA and tsiCrossDn
    if not crossServedS
        rNoBrk += 1
    crossServedS := false
if not isModeA and breakLong
    crossServedL := true
if not isModeA and breakShort
    crossServedS := true

if validTF and allowLong and longSig
    gOK = isModeA or (not na(gapUp) and gapUp <= tsiGapMax)
    anchorL = isModeA ? bullAnchor : loDipVal
    stopP = anchorL - bufMult * atrV
    dist = close - stopP
    if not ctxBull
        rNoDiv += 1
    else if not gOK
        rGap += 1
    else if not seqOkL
        rSeq += 1
    else if na(dist) or dist <= 0
        rStop += 1
    else if not flat
        rBlocked += 1
    else
        riskAcct = strategy.equity * (riskPct / 100)
        riskQuote = strategy.convert_to_symbol(riskAcct)
        qty = riskQuote / dist
        strategy.entry("L", strategy.long, qty=qty)
        eStop := stopP
        eTgt := close + dist
        lastRiskAcct := riskAcct
        lastDist := dist
        entriesL += 1
        longEntry := true
        sumCostR += (spreadPips + slipPips) * pip / dist
        gv = isModeA ? 0 : gapUp
        g0 += gv == 0 ? 1 : 0
        g1 += gv == 1 ? 1 : 0
        g2 += gv == 2 ? 1 : 0
        g3p += gv >= 3 ? 1 : 0
        if showTradeDetail
            lev = strategy.convert_to_account(qty * close) / strategy.equity
            simLoss = strategy.convert_to_account(qty * dist)
            varPct = 100.0 * (simLoss - riskAcct) / riskAcct
            label.new(bar_index, low, "LONG  eq " + str.tostring(strategy.equity, "#") + "  risk " + str.tostring(riskAcct, "#.0") + "  stop " + str.tostring(stopP, format.mintick) + "  dist " + str.tostring(dist / pip, "#.0") + "p  qty " + str.tostring(qty, "#") + "  lev " + str.tostring(lev, "#.0") + "x  simLoss " + str.tostring(simLoss, "#.0") + " (" + str.tostring(varPct, "#.0") + "% var)", style=label.style_label_up, color=color.new(color.blue, 40), textcolor=color.white, size=size.tiny)
            label.new(isModeA ? bar_index : loDipBar, anchorL, "stop anchor", style=label.style_label_up, color=color.new(color.blue, 60), textcolor=color.white, size=size.tiny)

if validTF and allowShort and shortSig and not longEntry
    gOK = isModeA or (not na(gapDn) and gapDn <= tsiGapMax)
    anchorS = isModeA ? bearAnchor : shPeakVal
    stopP = anchorS + bufMult * atrV
    dist = stopP - close
    if not ctxBear
        rNoDiv += 1
    else if not gOK
        rGap += 1
    else if not seqOkS
        rSeq += 1
    else if na(dist) or dist <= 0
        rStop += 1
    else if not flat
        rBlocked += 1
    else
        riskAcct = strategy.equity * (riskPct / 100)
        riskQuote = strategy.convert_to_symbol(riskAcct)
        qty = riskQuote / dist
        strategy.entry("S", strategy.short, qty=qty)
        eStop := stopP
        eTgt := close - dist
        lastRiskAcct := riskAcct
        lastDist := dist
        entriesS += 1
        shortEntry := true
        sumCostR += (spreadPips + slipPips) * pip / dist
        gv = isModeA ? 0 : gapDn
        g0 += gv == 0 ? 1 : 0
        g1 += gv == 1 ? 1 : 0
        g2 += gv == 2 ? 1 : 0
        g3p += gv >= 3 ? 1 : 0
        if showTradeDetail
            lev = strategy.convert_to_account(qty * close) / strategy.equity
            simLoss = strategy.convert_to_account(qty * dist)
            varPct = 100.0 * (simLoss - riskAcct) / riskAcct
            label.new(bar_index, high, "SHORT  eq " + str.tostring(strategy.equity, "#") + "  risk " + str.tostring(riskAcct, "#.0") + "  stop " + str.tostring(stopP, format.mintick) + "  dist " + str.tostring(dist / pip, "#.0") + "p  qty " + str.tostring(qty, "#") + "  lev " + str.tostring(lev, "#.0") + "x  simLoss " + str.tostring(simLoss, "#.0") + " (" + str.tostring(varPct, "#.0") + "% var)", style=label.style_label_down, color=color.new(color.orange, 40), textcolor=color.white, size=size.tiny)
            label.new(isModeA ? bar_index : shPeakBar, anchorS, "stop anchor", style=label.style_label_down, color=color.new(color.orange, 60), textcolor=color.white, size=size.tiny)

strategy.exit("Lx", "L", stop=eStop, limit=eTgt)
strategy.exit("Sx", "S", stop=eStop, limit=eTgt)

plotshape(longEntry, title="LONG ENTRY", style=shape.triangleup, location=location.belowbar, color=color.new(color.blue, 0), size=size.normal)
plotshape(shortEntry, title="SHORT ENTRY", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.normal)
plot(strategy.position_size != 0 ? eStop : na, title="Stop", style=plot.style_linebr, color=color.red, linewidth=1)
plot(strategy.position_size != 0 ? eTgt : na, title="Target 1R", style=plot.style_linebr, color=color.new(color.blue, 30), linewidth=1)

var array<line> curLines = array.new<line>()
if barstate.islast
    while array.size(curLines) > 0
        line.delete(array.pop(curLines))
    if showLine and not isModeA and fitOkL and not na(slopeL) and not consL
        array.push(curLines, line.new(loOriginBar, loOriginVal, bar_index, lineL, color=color.new(color.green, 20), width=2))
    if showLine and not isModeA and fitOkS and not na(slopeS) and not consS
        array.push(curLines, line.new(shOriginBar, shOriginVal, bar_index, lineS, color=color.new(color.red, 20), width=2))

// ------------------------- TRADE-CLOSE ACCOUNTING ----------------------------
var float sumR = 0.0
var int lastN = 0
var int lWins = 0
var int lLoss = 0
var int sWins = 0
var int sLoss = 0
var int lossStreak = 0
var int maxLossStreak = 0
var int sumHoldBars = 0
n = strategy.closedtrades
if n > lastN
    prof = strategy.closedtrades.profit(n - 1)
    szn = strategy.closedtrades.size(n - 1)
    if not na(lastRiskAcct) and lastRiskAcct > 0
        sumR += prof / lastRiskAcct
    sumHoldBars += strategy.closedtrades.exit_bar_index(n - 1) - strategy.closedtrades.entry_bar_index(n - 1)
    if prof > 0
        lossStreak := 0
        if szn > 0
            lWins += 1
        else
            sWins += 1
    else
        lossStreak += 1
        maxLossStreak := math.max(maxLossStreak, lossStreak)
        if szn > 0
            lLoss += 1
        else
            sLoss += 1
    lastN := n

var int t0 = na
if barstate.isfirst
    t0 := time

// ---------------------------- DASHBOARD --------------------------------------
var table dash = table.new(position.top_right, 2, 19, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))
dRow(r, k, v) =>
    table.cell(dash, 0, r, k, text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, r, v, text_color=color.yellow, text_size=size.tiny, text_halign=text.align_right)
if barstate.islast and showDash
    weeks = math.max((time - t0) / 604800000.0, 0.001)
    tot = strategy.closedtrades
    wr = tot > 0 ? 100.0 * strategy.wintrades / tot : 0.0
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    netPct = 100.0 * strategy.netprofit / strategy.initial_capital
    ddPct = 100.0 * strategy.max_drawdown / strategy.initial_capital
    avgR = tot > 0 ? sumR / tot : 0.0
    avgCostR = tot > 0 ? sumCostR / tot : 0.0
    adjAvgR = avgR - avgCostR
    adjNetPct = netPct - 100.0 * sumCostR * (riskPct / 100)
    dRow(0, "MODE", isModeA ? "A LEGACY BENCHMARK (no trendline)" : "B EXPERIMENTAL (TL parity NOT approved)")
    dRow(1, validTF ? "Timeframe" : "TIMEFRAME INVALID - NO TRADES", validTF ? "4H OK" : timeframe.period)
    dRow(2, "Closed trades", str.tostring(tot))
    dRow(3, "Trades/week", str.tostring(tot / weeks, "#.00"))
    dRow(4, "Wins / Losses", str.tostring(strategy.wintrades) + "/" + str.tostring(strategy.losstrades))
    dRow(5, "Win rate", str.tostring(wr, "#.0") + "%")
    dRow(6, "Profit factor (gross)", str.tostring(pf, "#.00"))
    dRow(7, "Avg R/trade (gross)", str.tostring(avgR, "#.00"))
    dRow(8, "Net (gross)", str.tostring(netPct, "#.0") + "%")
    dRow(9, "Max drawdown", str.tostring(ddPct, "#.0") + "%")
    dRow(10, "Max consec losses", str.tostring(maxLossStreak))
    dRow(11, "LONG W/L", str.tostring(lWins) + "/" + str.tostring(lLoss))
    dRow(12, "SHORT W/L", str.tostring(sWins) + "/" + str.tostring(sLoss))
    dRow(13, "Avg hold (bars)", tot > 0 ? str.tostring(sumHoldBars / tot) : "0")
    dRow(14, "Blocked (pos open)", str.tostring(rBlocked))
    dRow(15, "Rejects nodiv/gap/seq/stop", str.tostring(rNoDiv) + "/" + str.tostring(rGap) + "/" + str.tostring(rSeq) + "/" + str.tostring(rStop))
    dRow(16, isModeA ? "Mode A: no TL rejects" : "Cross w/o break", isModeA ? "-" : str.tostring(rNoBrk))
    dRow(17, "Entry TSIgap 0/1/2/3+", str.tostring(g0) + "/" + str.tostring(g1) + "/" + str.tostring(g2) + "/" + str.tostring(g3p))
    dRow(18, "COST-ADJ avgR | net (spread+slip)", str.tostring(adjAvgR, "#.00") + " | " + str.tostring(adjNetPct, "#.0") + "%")

// ---------------- PARITY AUDIT (AUDUSD examples, display only) ---------------
var tNames = array.from("T6", "T7", "T8", "T1", "T2", "T3", "T4", "T5", "S1", "S2")
var tTimes = array.from(timestamp("GMT+1", 2026, 7, 21, 9, 0), timestamp("GMT+1", 2026, 7, 23, 5, 0), timestamp("GMT+1", 2026, 7, 27, 13, 0), timestamp("GMT+1", 2026, 7, 29, 13, 0), timestamp("GMT+1", 2026, 8, 2, 21, 0), timestamp("GMT+1", 2026, 8, 3, 21, 0), timestamp("GMT+1", 2026, 8, 5, 21, 0), timestamp("GMT+1", 2026, 8, 7, 1, 0), timestamp("GMT+1", 2026, 7, 25, 1, 0), timestamp("GMT+1", 2026, 7, 31, 5, 0))
var tExp = array.from("SHORT", "SHORT", "SHORT", "LONG", "LONG", "LONG", "SHORT", "LONG", "SKIP", "SKIP")
var tRes = array.new_string(10, "n/f")
if barstate.isconfirmed
    for i = 0 to 9
        if time == array.get(tTimes, i)
            ent = longEntry ? "ENT-L" : shortEntry ? "ENT-S" : "no-ent"
            exp = array.get(tExp, i)
            pass = exp == "SKIP" ? (not longEntry and not shortEntry ? "PASS" : "FAIL") : (exp == "LONG" and longEntry) or (exp == "SHORT" and shortEntry) ? "PASS" : "FAIL"
            s = (tsiCrossUp ? "Tup " : tsiCrossDn ? "Tdn " : "noT ") + (bullCnt > 0 ? "dB" + str.tostring(bullCnt) : bearCnt > 0 ? "dS" + str.tostring(bearCnt) : "d0") + " #" + str.tostring(runLen) + " " + (isModeA ? "" : breakLong ? "BRKL " : breakShort ? "BRKS " : "noBRK ") + ent + " " + pass
            array.set(tRes, i, s)
var table par = table.new(position.bottom_right, 3, 11, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast and showParity
    table.cell(par, 0, 0, "Ex", text_color=color.white, text_size=size.tiny)
    table.cell(par, 1, 0, "Expected", text_color=color.white, text_size=size.tiny)
    table.cell(par, 2, 0, "Observed (TSI/div/#seq/brk/entry/verdict)", text_color=color.white, text_size=size.tiny)
    for i = 0 to 9
        table.cell(par, 0, i + 1, array.get(tNames, i), text_color=color.white, text_size=size.tiny)
        table.cell(par, 1, i + 1, array.get(tExp, i), text_color=color.yellow, text_size=size.tiny)
        table.cell(par, 2, i + 1, array.get(tRes, i), text_color=color.yellow, text_size=size.tiny, text_halign=text.align_right)
